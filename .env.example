# Copy to .env.local for local development. Never commit real values.
# On Vercel, set these under Project → Settings → Environment Variables
# (separately for Production and Preview/Development).

# Neon *pooled* connection string (host contains "-pooler"). Used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-pooler.REGION.aws.neon.tech/school_results?sslmode=require&channel_binding=require"

# Neon *direct* (unpooled) connection string. Used only for migrations and the create-admin script.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-example.REGION.aws.neon.tech/school_results?sslmode=require&channel_binding=require"

# Optional session settings (defaults shown).
SESSION_IDLE_MINUTES=60
SESSION_MAX_HOURS=12

# DEVELOPMENT ONLY: skip the sign-in page and act as this staff member (all permission checks still apply).
# Refused in production. Leave unset on Vercel.
# DEV_AUTO_LOGIN="principal@yourschool.edu"
